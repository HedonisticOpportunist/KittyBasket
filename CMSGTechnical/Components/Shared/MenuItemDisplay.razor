@using CMSGTechnical.Domain.Models
@using CMSGTechnical.Mediator.Dtos

<div class="menu-row">
    <div class="menu-left">
        <div class="menu-item">
            <p class="menu-title">
                <strong>@Item?.Name</strong>
                <span class="price">£@Item?.Price</span>
            </p>

            <p class="menu-category">
                <em>@Item?.Category</em>
            </p>

            @if (!string.IsNullOrWhiteSpace(Item?.Description))
            {
                <p class="menu-description">@Item.Description</p>
            }
        </div>
    </div>

    <div class="menu-buttons">
        @if (OnAdd.HasDelegate)
        {
            <button class="btn btn-primary btn-round" @onclick="Add">🐾</button>
        }
        @if (OnRemove.HasDelegate)
        {
            <button class="btn btn-primary btn-round" @onclick="Remove">🗑️</button>
        }
    </div>
</div>

@code {

    [Parameter, EditorRequired]
    public MenuItemDto? Item { get; set; } // Enssures that chocolate is not getting selecting by mistake all the time.

    [Parameter]
    public EventCallback<MenuItemDto> OnAdd { get; set; }

    [Parameter]
    public EventCallback<MenuItemDto> OnRemove { get; set; }

    private async Task Remove() => await OnRemove.InvokeAsync(Item);
    private async Task Add() => await OnAdd.InvokeAsync(Item);

}